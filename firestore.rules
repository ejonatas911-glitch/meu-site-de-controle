rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidPerson(data, userId) {
      return data.keys().hasAll(['id', 'name', 'userId']) &&
        data.keys().hasOnly(['id', 'name', 'userId', 'isDefault', 'createdAt']) &&
        data.id is string && isValidId(data.id) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.userId == userId &&
        (!('isDefault' in data) || data.isDefault is bool) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    function isValidExpense(data, userId) {
      return data.keys().hasAll([
          'id', 'userId', 'personId', 'type', 'title',
          'originalAmount', 'installmentAmount', 'totalInstallments',
          'startDate', 'frequency', 'installments'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'personId', 'type', 'title',
          'originalAmount', 'installmentAmount', 'totalInstallments',
          'startDate', 'frequency', 'notes', 'installments', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && isValidId(data.id) &&
        data.userId == userId &&
        data.personId is string && isValidId(data.personId) &&
        (data.type == 'emprestimo' || data.type == 'despesa') &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
        data.originalAmount is number && data.originalAmount >= 0 &&
        data.installmentAmount is number && data.installmentAmount >= 0 &&
        data.totalInstallments is number && data.totalInstallments >= 1 && data.totalInstallments <= 360 &&
        data.startDate is string && data.startDate.size() <= 20 &&
        (data.frequency == 'diaria' || data.frequency == 'semanal' || data.frequency == 'mensal') &&
        data.installments is list && data.installments.size() <= 360 &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    // User's private people collection
    match /users/{userId}/people/{personId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) &&
        isValidId(personId) &&
        incoming().id == personId &&
        isValidPerson(incoming(), userId);
      allow update: if isOwner(userId) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        isValidPerson(incoming(), userId);
      allow delete: if isOwner(userId);
    }

    // User's private expenses collection
    match /users/{userId}/expenses/{expenseId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) &&
        isValidId(expenseId) &&
        incoming().id == expenseId &&
        isValidExpense(incoming(), userId);
      allow update: if isOwner(userId) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        isValidExpense(incoming(), userId);
      allow delete: if isOwner(userId);
    }
  }
}
